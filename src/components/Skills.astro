  title: string;
  subtitle: string;
  description: string;
  accent: "secondary" | "primary" | "tertiary";
  iconSvg: string;
  points: string[];
}

interface TechItem {
  name: string;
  category: "Frontend" | "Backend" | "Database" | "Tools";
  svg: string;
}

