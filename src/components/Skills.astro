---

<section id="skills" class="relative py-28 overflow-hidden">
  <!-- Ambient background glow matching palette -->
  <div class="pointer-events-none absolute inset-0">
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-[600px] w-[600px] rounded-full bg-primary/5 blur-[160px]"
    >
    </div>
    <div
      class="absolute -top-32 right-10 h-[400px] w-[400px] rounded-full bg-secondary/5 blur-[140px]"
    >
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-7xl px-6">
    <!-- Section Header aligned with Hero & Projects -->
    <div class="mb-16">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5 font-mono text-xs font-semibold uppercase tracking-widest text-primary-light"
      >
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-primary"></span>
        Skills &amp; Expertise
      </span>

      <div
        class="mt-6 flex flex-col md:flex-row md:items-end md:justify-between gap-4"
      >
        <div>
          <h2 class="text-5xl font-extrabold tracking-tight sm:text-6xl">
            Core<br />
            <span
              class="bg-gradient-to-r from-secondary via-primary to-tertiary bg-clip-text text-transparent"
            >
              Capabilities
            </span>
          </h2>
          <p class="mt-4 text-xl font-medium text-text-muted">
            Software engineering &amp; modern product craft
          </p>
        </div>

        <p
          class="font-mono text-sm text-text-muted/60 uppercase tracking-widest"
        >
          Stack &amp; Strengths
        </p>
      </div>

      <div class="mt-6 h-px w-24 bg-gradient-to-r from-primary to-transparent">
      </div>
    </div>

    <!-- PART 1: Core Capabilities (Responsive 3-Column Grid) -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 mb-20">
      {
        capabilities.map((cap) => (
          <div class="group relative rounded-3xl p-[1.5px] bg-gradient-to-br from-border via-border/50 to-border/20 transition-all duration-300 hover:from-secondary/50 hover:via-primary/50 hover:to-tertiary/40 hover:shadow-xl hover:shadow-primary/10">
            <div class="flex h-full flex-col justify-between rounded-[22px] bg-surface/90 p-8 backdrop-blur-sm transition-all group-hover:bg-surface/95">
              <div>
                {/* Top icon and badge */}
                <div class="flex items-center justify-between gap-4 mb-6">
                  <div
                    class="flex h-12 w-12 items-center justify-center rounded-2xl border border-border bg-surface-light text-primary-light transition-all group-hover:border-primary/40 group-hover:text-white group-hover:scale-105"
                    set:html={cap.iconSvg}
                  />
                  <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-text-muted/70">
                    {cap.subtitle}
                  </span>
                </div>

                {/* Title */}
                <h3 class="text-2xl font-bold tracking-tight text-text group-hover:text-white transition-colors">
                  {cap.title}
                </h3>

                {/* Description */}
                <p class="mt-3 text-sm leading-relaxed text-text-muted">
                  {cap.description}
                </p>
              </div>

              {/* Bullet points */}
              <div class="mt-8 pt-6 border-t border-border/60">
                <ul class="flex flex-col gap-2.5">
                  {cap.points.map((point) => (
                    <li class="flex items-center gap-2.5 text-xs text-text-muted">
                      <span class="h-1 w-1 rounded-full bg-primary-light" />
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <!-- PART 2: Technologies & Stack -->
    <div
      class="rounded-3xl border border-border bg-surface/40 p-8 sm:p-12 backdrop-blur-sm"
    >
      <div
        class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8"
      >
        <div>
          <span
            class="font-mono text-xs font-semibold uppercase tracking-widest text-secondary-light"
          >
            Technologies &amp; Frameworks
          </span>
          <h3
            class="mt-2 text-2xl sm:text-3xl font-bold tracking-tight text-text"
          >
            My Daily Stack
          </h3>
        </div>
        <p class="text-sm text-text-muted max-w-sm">
          Battle-tested libraries, runtimes, and datastores powering scalable
          full-stack applications.
        </p>
      </div>

      {/* Grid of Tech Badges with SVG Icons */}
      <div
        class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4"
      >
        {
          techStack.map((tech) => (
            <div class="group flex items-center gap-3.5 rounded-xl border border-border/80 bg-surface-light/40 px-4 py-3 transition-all duration-200 hover:border-primary/40 hover:bg-surface-light hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary/5">
              <div
                class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-background/80 border border-border/60 text-text transition-transform group-hover:scale-110"
                set:html={tech.svg}
              />
              <div class="flex flex-col overflow-hidden">
                <span class="text-sm font-semibold text-text truncate group-hover:text-white transition-colors">
                  {tech.name}
                </span>
                <span class="font-mono text-[10px] text-text-muted/70 tracking-wider uppercase truncate">
                  {tech.category}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Bottom separator line -->
  <div class="mx-auto mt-28 max-w-7xl px-6">
    <div
      class="h-px bg-gradient-to-r from-transparent via-border to-transparent"
    >
    </div>
  </div>
</section>
