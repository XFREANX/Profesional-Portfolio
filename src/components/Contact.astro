---
/**
 * Contact Section – Refactored, minimalist & lightweight contact area.
 * Clean typography, discreet info items, subtle form styling, and solid accent CTA button.
 */
---

<section id="contact" class="relative py-24 overflow-hidden">
  <!-- Subtle ambient glow -->
  <div class="pointer-events-none absolute inset-0">
    <div
      class="absolute top-1/2 -left-40 h-[400px] w-[400px] rounded-full bg-secondary/5 blur-[140px]"
    >
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-7xl px-6">
    <!-- 2-Column Responsive Layout -->
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16 items-start">
      <!-- Left Column: Header & Discreet Contact Info -->
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div>
          <span
            class="inline-flex items-center gap-2 rounded-full border border-secondary/30 bg-secondary/10 px-3.5 py-1 font-mono text-xs font-medium uppercase tracking-widest text-secondary-light"
          >
            <span class="inline-block h-1.5 w-1.5 rounded-full bg-secondary"
            ></span>
            Contact
          </span>

          <h2
            class="mt-4 text-2xl sm:text-3xl font-bold tracking-tight text-text"
          >
            Let's build something extraordinary together.
          </h2>

          <p class="mt-3 text-sm leading-relaxed text-slate-400">
            Whether you have a full-time engineering role, an ambitious side
            project, or just want to talk tech and architecture, my inbox is
            always open.
          </p>
        </div>

        <!-- Streamlined, minimal contact details -->
        <div class="mt-8 pt-6 border-t border-border/60 flex flex-col gap-4">
          <!-- Email link -->
          <a
            href="mailto:ferrerfranklin17@gmail.com"
            class="group inline-flex items-center gap-3 text-xs sm:text-sm font-mono text-slate-400 transition-colors hover:text-secondary-light"
          >
            <svg
              class="h-4 w-4 shrink-0 text-secondary-light/80"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              viewBox="0 0 24 24"
            >
              <rect
                width="20"
                height="16"
                x="2"
                y="4"
                rx="2"
                stroke-linecap="round"
                stroke-linejoin="round"></rect>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span class="truncate">ferrerfranklin17@gmail.com</span>
          </a>

          <!-- Location -->
          <div
            class="inline-flex items-center gap-3 text-xs sm:text-sm font-mono text-slate-400"
          >
            <svg
              class="h-4 w-4 shrink-0 text-primary-light/80"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle
                cx="12"
                cy="10"
                r="3"
                stroke-linecap="round"
                stroke-linejoin="round"></circle>
            </svg>
            <span>Santo Domingo, Dominican Republic</span>
          </div>

          <!-- Availability status -->
          <div
            class="inline-flex items-center gap-2 pt-1 font-mono text-[11px] text-slate-500"
          >
            <span
              class="inline-block h-1.5 w-1.5 rounded-full bg-green-400 animate-pulse"
            ></span>
            <span>Available for new opportunities</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Clean Form -->
      <div class="lg:col-span-7">
        <div
          class="rounded-2xl border border-border bg-surface/40 p-6 sm:p-8 backdrop-blur-sm"
        >
          <form
            class="flex flex-col gap-5"
            action="mailto:ferrerfranklin17@gmail.com"
            method="POST"
            enctype="text/plain"
          >
            <!-- Name Input -->
            <div class="flex flex-col gap-1.5">
              <label
                for="name"
                class="font-mono text-xs text-slate-400 uppercase tracking-wider"
              >
                Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="John Doe"
                class="w-full rounded-xl border border-border/80 bg-slate-900/50 px-4 py-2.5 text-sm text-text placeholder:text-slate-600 transition-colors focus:border-secondary focus:bg-slate-900 focus:outline-none focus:ring-1 focus:ring-secondary/30"
              />
            </div>

            <!-- Email Input -->
            <div class="flex flex-col gap-1.5">
              <label
                for="email"
                class="font-mono text-xs text-slate-400 uppercase tracking-wider"
              >
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="john@example.com"
                class="w-full rounded-xl border border-border/80 bg-slate-900/50 px-4 py-2.5 text-sm text-text placeholder:text-slate-600 transition-colors focus:border-secondary focus:bg-slate-900 focus:outline-none focus:ring-1 focus:ring-secondary/30"
              />
            </div>

            <!-- Message Input -->
            <div class="flex flex-col gap-1.5">
              <label
                for="message"
                class="font-mono text-xs text-slate-400 uppercase tracking-wider"
              >
                Message
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Tell me about your project or role..."
                class="w-full resize-y rounded-xl border border-border/80 bg-slate-900/50 px-4 py-2.5 text-sm text-text placeholder:text-slate-600 transition-colors focus:border-secondary focus:bg-slate-900 focus:outline-none focus:ring-1 focus:ring-secondary/30"
              ></textarea>
            </div>

            <!-- Submit Button (Solid Secondary Blue Matching 'Hire Me') -->
            <div class="pt-2">
              <button
                type="submit"
                class="inline-flex items-center gap-2 rounded-lg bg-secondary px-6 py-2.5 text-sm font-semibold text-white transition-all hover:bg-secondary-light hover:shadow-lg hover:shadow-secondary/25 active:translate-y-0 cursor-pointer"
              >
                <span>Send Message</span>
                <svg
                  class="h-4 w-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5"
                  ></path>
                </svg>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
