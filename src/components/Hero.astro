---
/**
 * Hero Section – grid background with colored glows, intro text, gradient-framed
 * profile photo and an infinite tech marquee along the bottom edge.
 * Ships zero JS (pure Astro component + CSS animations).
 */

const marqueeItems = [
  "UX / UI",
  "AI Solutions",
  "React",
  "TypeScript",
  "Node.js",
  "Express",
  "Clean Code",
  "Scalable Architecture",
];
---

<section
  id="home"
  class="relative flex min-h-svh flex-col overflow-hidden pt-28"
>
  <!-- Background: grid pattern + colored glows -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="hero-grid absolute inset-0"></div>
    <div
      class="absolute -left-32 -top-32 h-[560px] w-[560px] rounded-full bg-secondary/25 blur-[140px]"
    >
    </div>
    <div
      class="absolute -right-40 top-1/4 h-[620px] w-[620px] rounded-full bg-primary/25 blur-[150px]"
    >
    </div>
    <div
      class="absolute -bottom-48 left-1/2 h-[420px] w-[720px] -translate-x-1/2 rounded-full bg-tertiary/15 blur-[150px]"
    >
    </div>
  </div>

  <!-- Content -->
  <div class="relative mx-auto flex w-full max-w-7xl flex-1 items-center px-6 py-12 lg:py-16">
    <div
      class="flex w-full flex-col-reverse items-center gap-14 lg:flex-row lg:justify-between lg:gap-20"
    >
      <!-- Left Column – Text -->
      <div class="max-w-2xl flex-1 text-center lg:text-left">
        <!-- Badge -->
        <span
          class="inline-flex items-center gap-2.5 whitespace-nowrap rounded-full border border-secondary/30 bg-secondary/5 px-4 py-2 font-mono text-[10px] font-semibold uppercase tracking-[0.15em] text-secondary-light animate-fade-in sm:px-5 sm:text-xs sm:tracking-[0.25em]"
        >
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-400 shadow-[0_0_10px] shadow-emerald-400/70"></span>
          Full Stack Software Developer
        </span>

        <!-- Name -->
        <h1
          class="mt-8 text-6xl font-extrabold leading-[0.95] tracking-tight sm:text-7xl lg:text-8xl animate-slide-up"
        >
          Franklin<br />
          <span
            class="bg-gradient-to-r from-secondary-light via-secondary to-primary bg-clip-text pb-2 text-transparent"
          >
            Ferrer
          </span>
        </h1>

        <!-- Description -->
        <p
          class="mx-auto mt-8 max-w-xl text-lg leading-relaxed text-slate-300 sm:text-xl lg:mx-0 animate-slide-up"
          style="animation-delay: .15s"
        >
          Crafting high-performance web applications with modern technologies.
          Passionate about clean code, scalable architecture, and exceptional
          user experiences.
        </p>

        <!-- CTAs -->
        <div
          class="mt-10 flex flex-wrap items-center justify-center gap-4 lg:justify-start animate-slide-up"
          style="animation-delay: .3s"
        >
          <!-- View CV -->
          <a
            href="/Franklin_Ferrer_DEV.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 rounded-2xl bg-gradient-to-r from-secondary to-primary px-7 py-4 text-base font-semibold text-white shadow-xl shadow-secondary/25 transition-all hover:-translate-y-0.5 hover:shadow-2xl hover:shadow-primary/35 active:translate-y-0"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"
              ></path>
            </svg>
            View CV
          </a>

          <!-- Explore Projects -->
          <a
            href="#projects"
            class="inline-flex items-center gap-2.5 rounded-2xl border border-white/10 bg-white/[0.03] px-7 py-4 text-base font-semibold text-text backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:border-white/20 hover:bg-white/[0.06] active:translate-y-0"
          >
            Explore Projects
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column – Profile photo with gradient frame (no overlays) -->
      <div class="relative shrink-0 animate-fade-in" style="animation-delay: .2s">
        <!-- Soft glow behind the frame -->
        <div
          class="absolute -inset-6 rounded-[2.5rem] bg-gradient-to-br from-primary/40 to-secondary/30 blur-3xl"
          aria-hidden="true"
        >
        </div>
        <div
          class="relative rounded-[2rem] bg-gradient-to-br from-primary via-tertiary/80 to-secondary-light p-[3px] shadow-2xl shadow-primary/30"
        >
          <div class="overflow-hidden rounded-[calc(2rem-3px)] bg-surface">
            <img
              src="/profile.jpg"
              width="800"
              height="800"
              fetchpriority="high"
              alt="Franklin Ferrer - Full Stack Software Engineer"
              class="h-80 w-64 object-cover transition-transform duration-500 hover:scale-105 sm:h-[26rem] sm:w-80 lg:h-[30rem] lg:w-[23rem]"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Tech marquee -->
  <div
    class="hero-marquee relative border-t border-white/5 bg-background/40 py-6 backdrop-blur-sm"
  >
    <p class="sr-only">{marqueeItems.join(", ")}</p>
    <div class="hero-marquee-track flex w-max" aria-hidden="true">
      {
        [0, 1].map(() => (
          <ul class="flex shrink-0 items-center">
            {marqueeItems.map((item) => (
              <li class="flex items-center">
                <span class="whitespace-nowrap px-8 text-xl font-medium text-slate-300 sm:text-2xl">
                  {item}
                </span>
                <span class="text-lg text-primary-light">✦</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Subtle grid that fades out towards the edges */
  .hero-grid {
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.04) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.04) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 40%, transparent 100%);
  }

  /* Fade the marquee in and out at both edges */
  .hero-marquee {
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  /* Two identical lists side by side: shifting by -50% loops seamlessly */
  .hero-marquee-track {
    animation: marquee 40s linear infinite;
  }
  .hero-marquee:hover .hero-marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-marquee-track {
      animation: none;
    }
  }
</style>
