---
/**
 * Hero Section – two-column layout with animated intro text and gradient profile card.
 * Ships zero JS (pure Astro component).
 */
---

<section
  id="home"
  class="relative min-h-[90vh] flex items-center overflow-hidden py-28 pt-32"
>
  <!-- Background glow effects -->
  <div class="pointer-events-none absolute inset-0">
    <div
      class="absolute -top-40 -left-40 h-[500px] w-[500px] rounded-full bg-primary/10 blur-[120px]"
    >
    </div>
    <div
      class="absolute -bottom-40 -right-40 h-[500px] w-[500px] rounded-full bg-secondary/10 blur-[120px]"
    >
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-7xl px-6">
    <div
      class="flex flex-col-reverse items-center gap-16 lg:flex-row lg:items-center lg:gap-24"
    >
      <!-- Left Column – Text -->
      <div class="flex-1 text-center lg:text-left">
        <!-- Badge -->
        <span
          class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5 font-mono text-xs font-semibold uppercase tracking-widest text-primary-light animate-fade-in"
        >
          <span
            class="inline-block h-1.5 w-1.5 rounded-full bg-primary animate-pulse"
          ></span>
          Full Stack Software Developer
        </span>

        <!-- Name -->
        <h1
          class="mt-6 text-5xl font-extrabold leading-tight tracking-tight sm:text-6xl lg:text-7xl animate-slide-up"
        >
          Franklin<br />
          <span
            class="bg-gradient-to-r from-secondary via-primary to-tertiary bg-clip-text text-transparent"
          >
            Ferrer
          </span>
        </h1>

        <!-- Description -->
        <p
          class="mt-6 max-w-lg text-lg leading-relaxed text-text-muted animate-slide-up"
          style="animation-delay: .15s"
        >
          Crafting high-performance web applications with modern technologies.
          Passionate about clean code, scalable architecture, and exceptional
          user experiences.
        </p>

        <!-- CTAs -->
        <div
          class="mt-8 flex flex-wrap items-center justify-center gap-4 lg:justify-start animate-slide-up"
          style="animation-delay: .3s"
        >
          <!-- Download CV -->
          <a
            href="/cv.pdf"
            download
            class="inline-flex items-center gap-2 rounded-xl bg-secondary px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-secondary/25 transition-all hover:bg-secondary-light hover:shadow-xl hover:shadow-secondary/30 hover:-translate-y-0.5 active:translate-y-0"
          >
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V3"
              ></path>
            </svg>
            Download CV
          </a>

          <!-- Explore Projects -->
          <a
            href="#projects"
            class="inline-flex items-center gap-2 rounded-xl border border-border bg-surface/50 px-6 py-3 text-sm font-semibold text-text transition-all hover:border-primary/50 hover:bg-surface hover:-translate-y-0.5 active:translate-y-0"
          >
            Explore Projects
            <svg
              class="h-4 w-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column – Profile image card -->
      <div
        class="relative flex-shrink-0 animate-fade-in"
        style="animation-delay: .2s"
      >
        <!-- Gradient ring -->
        <div
          class="relative rounded-3xl p-[3px] bg-gradient-to-br from-secondary via-primary to-tertiary shadow-2xl shadow-primary/20"
        >
          <div
            class="flex h-80 w-72 flex-col items-center justify-center gap-3 bg-surface p-6 sm:h-96 sm:w-80"
          >
            <div
              class="flex h-24 w-24 items-center justify-center rounded-full bg-surface-light border border-border text-primary"
            >
              <svg
                class="h-12 w-12 text-text-muted"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
                ></path>
              </svg>
            </div>
            <span class="font-mono text-xs text-text-muted">Foto de Perfil</span
            >
            <span class="text-xs text-text-muted/60 text-center"
              >Coloca tu foto en <code class="text-primary-light"
                >public/profile.jpg</code
              ></span
            >
          </div>
        </div>

        <!-- Sparkle icon -->
        <div
          class="absolute -bottom-3 -right-3 flex h-12 w-12 items-center justify-center rounded-xl bg-surface border border-border shadow-lg animate-float"
        >
          <svg
            class="h-6 w-6 text-tertiary"
            fill="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M12 0l2.39 7.61L22 10l-7.61 2.39L12 20l-2.39-7.61L2 10l7.61-2.39L12 0z"
            ></path>
          </svg>
        </div>

        <!-- Secondary floating badge -->
        <div
          class="absolute -top-3 -left-3 flex items-center gap-1.5 rounded-lg bg-surface border border-border px-3 py-1.5 shadow-lg animate-float"
          style="animation-delay: 2s"
        >
          <span class="inline-block h-2 w-2 rounded-full bg-green-400"></span>
          <span class="font-mono text-xs text-text-muted"
            >Available for work</span
          >
        </div>
      </div>
    </div>
  </div>
</section>
