---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Franklin Ferrer | Full Stack Software Engineer",
  description = "Portfolio of Franklin Ferrer, a Full Stack Software Engineer in the Dominican Republic specializing in React, TypeScript and Node.js.",
} = Astro.props;

// Section anchors are relative on the home page and absolute elsewhere (e.g. /success)
const base = Astro.url.pathname === "/" ? "" : "/";
const navLinks = [
  { href: `${base}#home`, label: "Home" },
  { href: `${base}#about`, label: "About" },
  { href: `${base}#projects`, label: "Projects" },
  { href: `${base}#skills`, label: "Skills" },
  { href: `${base}#contact`, label: "Contact" },
];

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const ogImage = Astro.site ? new URL("/profile.jpg", Astro.site) : undefined;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#020617" />
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Franklin Ferrer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <title>{title}</title>
  </head>
  <body class="bg-background text-text min-h-screen">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-secondary focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
    >
      Skip to content
    </a>
    <!-- Navbar: transparent at the top, frosted once the page scrolls -->
    <header
      id="site-header"
      class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-300 data-[scrolled=true]:border-white/5 data-[scrolled=true]:bg-background/70 data-[scrolled=true]:backdrop-blur-xl"
    >
      <nav
        class="mx-auto flex w-full max-w-7xl items-center justify-between gap-6 px-6 py-4"
        aria-label="Main"
      >
        <!-- Logo -->
        <a href={`${base}#home`} class="group flex items-center gap-3" aria-label="Franklin Ferrer, back to top">
          <span
            class="grid h-10 w-10 place-items-center rounded-xl bg-gradient-to-br from-secondary to-primary text-lg font-bold text-white shadow-lg shadow-primary/30 transition-transform group-hover:scale-105"
            aria-hidden="true"
          >
            F
          </span>
          <span class="text-xl font-bold tracking-tight text-text">Franklin</span>
        </a>

        <!-- Nav links (center pill) -->
        <ul
          class="hidden items-center gap-1 rounded-full border border-white/10 bg-white/[0.03] p-1.5 text-sm font-medium text-text-muted backdrop-blur-md md:flex"
        >
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  data-nav-link
                  class="block rounded-full px-5 py-2 transition-colors hover:text-text aria-[current=location]:bg-white/10 aria-[current=location]:text-text"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <!-- CTA -->
        <a
          href={`${base}#contact`}
          class="hidden shrink-0 items-center gap-2 whitespace-nowrap rounded-xl bg-gradient-to-r from-secondary to-primary px-6 py-2.5 text-sm font-semibold text-white shadow-lg shadow-secondary/25 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-primary/30 lg:inline-flex"
        >
          Hire Me
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"></path>
          </svg>
        </a>

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="flex flex-col gap-1.5 rounded-lg p-2 md:hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="block h-0.5 w-6 bg-text-muted"></span>
          <span class="block h-0.5 w-6 bg-text-muted"></span>
          <span class="block h-0.5 w-6 bg-text-muted"></span>
        </button>
      </nav>

      <!-- Mobile menu -->
      <div
        id="mobile-menu"
        class="hidden border-t border-white/5 bg-background/95 backdrop-blur-xl md:hidden"
      >
        <ul class="flex flex-col gap-1 px-6 py-5 text-sm font-medium text-text-muted">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  data-nav-link
                  class="block rounded-lg px-4 py-2.5 transition-colors hover:text-text aria-[current=location]:bg-white/10 aria-[current=location]:text-text"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li class="pt-3">
            <a
              href={`${base}#contact`}
              class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-secondary to-primary px-6 py-2.5 text-sm font-semibold text-white"
            >
              Hire Me
            </a>
          </li>
        </ul>
      </div>
    </header>

    <!-- Main content -->
    <main id="main">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-border/50 bg-surface/30">
      <div
        class="mx-auto max-w-7xl px-6 py-10 flex flex-col md:flex-row items-center justify-between gap-4"
      >
        <p class="text-sm text-text-muted">
          &copy; {new Date().getFullYear()} Franklin Ferrer. All rights reserved.
        </p>
        <div class="flex items-center gap-6">
          <a
            href="https://github.com/XFREANX"
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-muted transition-colors hover:text-text"
            aria-label="GitHub"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
              ></path></svg
            >
          </a>
          <a
            href="https://www.linkedin.com/in/franklin-ferrer-855309348/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-muted transition-colors hover:text-text"
            aria-label="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path></svg
            >
          </a>
        </div>
      </div>
    </footer>

    <!-- Navbar behaviour (zero-framework vanilla JS) -->
    <script>
      // Mobile menu toggle
      const btn = document.getElementById("mobile-menu-btn");
      const menu = document.getElementById("mobile-menu");
      const setOpen = (open: boolean) => {
        menu?.classList.toggle("hidden", !open);
        btn?.setAttribute("aria-expanded", String(open));
      };
      btn?.addEventListener("click", () =>
        setOpen(menu?.classList.contains("hidden") ?? false),
      );
      menu
        ?.querySelectorAll("a")
        .forEach((link) => link.addEventListener("click", () => setOpen(false)));

      // Frosted header once the page scrolls
      const header = document.getElementById("site-header");
      const onScroll = () =>
        header?.setAttribute("data-scrolled", String(window.scrollY > 8));
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // Highlight the nav link of the section currently in view
      const links = [
        ...document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
      ];
      const setActive = (id: string) =>
        links.forEach((link) => {
          if (link.hash === `#${id}`) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
      const observer = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (entry.isIntersecting) setActive(entry.target.id);
          }),
        // A section counts as active while it crosses the middle of the viewport
        { rootMargin: "-50% 0px -50% 0px" },
      );
      new Set(links.map((link) => link.hash.slice(1))).forEach((id) => {
        const section = document.getElementById(id);
        if (section) observer.observe(section);
      });
    </script>
  </body>
</html>
