---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Franklin Ferrer | Full Stack Software Engineer",
  description = "Portfolio profesional de Franklin Ferrer — Full Stack Software Engineer especializado en React, TypeScript, Node.js y más.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-background text-text min-h-screen">
    <!-- Navbar -->
    <nav
      class="fixed top-0 inset-x-0 z-50 border-b border-border/50 backdrop-blur-xl bg-background/70"
    >
      <div class="w-full flex items-center justify-between px-6 md:px-12 py-4">
        <!-- Logo -->
        <a href="/" class="text-xl font-light text-text"> Franklin </a>

        <!-- Nav links (center) -->
        <ul
          class="hidden md:flex items-center gap-8 text-sm font-medium text-text-muted"
        >
          <li>
            <a href="#home" class="transition-colors hover:text-text">Home</a>
          </li>
          <li>
            <a href="#about" class="transition-colors hover:text-text">About</a>
          </li>
          <li>
            <a href="#projects" class="transition-colors hover:text-text"
              >Projects</a
            >
          </li>
          <li>
            <a href="#skills" class="transition-colors hover:text-text"
              >Skills</a
            >
          </li>
          <li>
            <a href="#contact" class="transition-colors hover:text-text"
              >Contact</a
            >
          </li>
        </ul>

        <!-- CTA -->
        <a
          href="#contact"
          class="hidden md:inline-flex items-center gap-2 rounded-lg bg-secondary px-5 py-2 text-sm font-semibold text-white transition-all hover:bg-secondary-light hover:shadow-lg hover:shadow-secondary/25"
        >
          Hire Me
        </a>

        <!-- Mobile hamburger -->
        <button
          id="mobile-menu-btn"
          class="md:hidden flex flex-col gap-1.5 p-2"
          aria-label="Toggle menu"
        >
          <span class="block h-0.5 w-6 bg-text-muted transition-transform"
          ></span>
          <span class="block h-0.5 w-6 bg-text-muted transition-opacity"></span>
          <span class="block h-0.5 w-6 bg-text-muted transition-transform"
          ></span>
        </button>
      </div>

      <!-- Mobile menu -->
      <div
        id="mobile-menu"
        class="hidden md:hidden border-t border-border/50 bg-background/95 backdrop-blur-xl"
      >
        <ul
          class="flex flex-col gap-4 px-6 py-6 text-sm font-medium text-text-muted"
        >
          <li>
            <a href="#home" class="block transition-colors hover:text-text"
              >Home</a
            >
          </li>
          <li>
            <a href="#about" class="block transition-colors hover:text-text"
              >About</a
            >
          </li>
          <li>
            <a href="#projects" class="block transition-colors hover:text-text"
              >Projects</a
            >
          </li>
          <li>
            <a href="#skills" class="block transition-colors hover:text-text"
              >Skills</a
            >
          </li>
          <li>
            <a href="#contact" class="block transition-colors hover:text-text"
              >Contact</a
            >
          </li>
          <li>
            <a
              href="#contact"
              class="inline-flex items-center gap-2 rounded-lg bg-secondary px-5 py-2 text-sm font-semibold text-white"
            >
              Hire Me
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <!-- Main content -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-border/50 bg-surface/30">
      <div
        class="mx-auto max-w-7xl px-6 py-10 flex flex-col md:flex-row items-center justify-between gap-4"
      >
        <p class="text-sm text-text-muted">
          &copy; {new Date().getFullYear()} Franklin Ferrer. All rights reserved.
        </p>
        <div class="flex items-center gap-6">
          <a
            href="https://github.com/XFREANX"
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-muted transition-colors hover:text-text"
            aria-label="GitHub"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"
              ></path></svg
            >
          </a>
          <a
            href="https://www.linkedin.com/in/franklin-ferrer-855309348/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-text-muted transition-colors hover:text-text"
            aria-label="LinkedIn"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"
              ><path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              ></path></svg
            >
          </a>
        </div>
      </div>
    </footer>

    <!-- Mobile menu toggle script (zero-framework vanilla JS) -->
    <script>
      const btn = document.getElementById("mobile-menu-btn");
      const menu = document.getElementById("mobile-menu");
      btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
      menu
        ?.querySelectorAll("a")
        .forEach((link) =>
          link.addEventListener("click", () => menu?.classList.add("hidden")),
        );
    </script>
  </body>
</html>
